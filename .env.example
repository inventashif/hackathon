# Optional OpenAI-compatible endpoint. Leave the key blank for extractive-only mode.
# NVIDIA NIM works here too: base URL https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Gemini Live (hands-free live voice chat)
# GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-3.8-live

# Optional path override. The default database is data/nexus_sop.sqlite3.
# SOP_DB_PATH=data/nexus_sop.sqlite3
