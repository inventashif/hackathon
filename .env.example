# NexusSOP environment configuration
#
# Copy this file to .env before starting the app. Never commit .env or put real
# API keys in this example file.

# Optional OpenAI-compatible provider for generated answer summaries.
# Leave LLM_API_KEY empty to use local extractive RAG mode.
# NVIDIA NIM is also supported:
# https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Required only for Gemini Live hands-free voice chat.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live

# Optional database path. The default is data/nexus_sop.sqlite3.
SOP_DB_PATH=data/nexus_sop.sqlite3
